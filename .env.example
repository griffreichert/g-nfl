# Supabase — copy to .env and fill in from dashboard → Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co

# New-style keys (projects created 2025+). Publishable key is what the app
# normally uses — same role/RLS behavior as the legacy anon key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: secret key (server-side only, bypasses RLS). NEVER expose outside
# backend env vars. Only set if a server-side task needs to skip RLS.
# SUPABASE_SECRET_KEY=sb_secret_...

# Legacy projects used this instead of the publishable key — still supported:
# SUPABASE_ANON_KEY=eyJ...

# Picks-app auth (#60). Without both of these, every sign-in fails, which is
# the right default for a deploy nobody has configured yet.

# Signs the session tokens. At least 32 bytes, HS256 per RFC 7518 3.2:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this signs everyone out, since it invalidates every issued token.
AUTH_SECRET=

# The one passphrase the room shares. Pick any string. Everyone in the pool is
# trusted, so this keeps the internet out and the name on a session is taken on
# trust from the dropdown.
APP_PASSPHRASE=

# Per-picker PINs, dormant since 2026-09-01. Read by nothing today. See
# src/g_nfl/api/pins.py for what to change to switch back to them.
# PICKER_PINS={}
